# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# Signs login tokens. Use a long random value (at least 32 characters), e.g.: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

DB_PASSWORD=change-me

# Creates demo users and three events on first start. Turn OFF for a real deployment.
#   admin@seatsure.dev (admin) and demo@seatsure.dev (customer), both using APP_SEED_PASSWORD
APP_SEED_ENABLED=true
APP_SEED_PASSWORD=ChangeMe123!

CORS_ALLOWED_ORIGINS=http://localhost:3000
GRAFANA_PASSWORD=admin
